# PostgreSQL
ConnectionStrings__PostgreSql=Host=localhost;Port=5432;Database=shipment_telemetry;Username=postgres;Password=postgres
Database__ConnectionString=Host=localhost;Port=5432;Database=shipment_telemetry;Username=postgres;Password=postgres

# Redis (optional performance cache)
Redis__Enabled=true
Redis__ConnectionString=localhost:6379

# CAP / RabbitMQ
Cap__Enabled=true
Cap__Transport=RabbitMQ
Cap__RabbitMqHost=localhost
Cap__RabbitMqPort=5672
Cap__RabbitMqUsername=guest
Cap__RabbitMqPassword=guest
Cap__RabbitMqVirtualHost=/
Cap__RabbitMqExchangeName=shipment.telemetry

# Outbox publisher
OutboxPublisher__PollingInterval=00:00:02
OutboxPublisher__BatchSize=50
OutboxPublisher__MaxRetries=5

# Telemetry retention
TelemetryRetention__Enabled=true
TelemetryRetention__RetentionDays=30
TelemetryRetention__CleanupInterval=06:00:00
