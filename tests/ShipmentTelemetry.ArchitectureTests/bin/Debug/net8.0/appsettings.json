{
  "ConnectionStrings": {
    "PostgreSql": "Host=localhost;Port=5432;Database=shipment_telemetry;Username=postgres;Password=postgres"
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=shipment_telemetry;Username=postgres;Password=postgres"
  },
  "Redis": {
    "Enabled": true,
    "ConnectionString": "localhost:6379"
  },
  "Cap": {
    "Enabled": true,
    "Transport": "RabbitMQ",
    "DefaultGroupName": "shipment-telemetry",
    "FailedRetryCount": 3,
    "FailedRetryIntervalSeconds": 60,
    "RabbitMqHost": "localhost",
    "RabbitMqPort": 5672,
    "RabbitMqUsername": "guest",
    "RabbitMqPassword": "guest",
    "RabbitMqVirtualHost": "/",
    "RabbitMqExchangeName": "shipment.telemetry"
  },
  "OutboxPublisher": {
    "PollingInterval": "00:00:02",
    "BatchSize": 50,
    "MaxRetries": 5
  },
  "TelemetryRetention": {
    "Enabled": true,
    "RetentionDays": 30,
    "CleanupInterval": "06:00:00"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
